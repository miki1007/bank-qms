{
  "name": "bank-qms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "bash scripts/dev-all.sh",
    "dev:site": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-all.sh",
    "build:site": "bash scripts/build-verified.sh",
    "android:build": "gradle -p apps/android :customer-app:assembleDebug :staff-app:assembleDebug",
    "android:test": "gradle -p apps/android test",
    "ios:generate": "xcodegen generate --spec apps/ios/project.yml",
    "ios:build": "xcodebuild -project apps/ios/BankQMS.xcodeproj -scheme BankQMSCustomer -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build && xcodebuild -project apps/ios/BankQMS.xcodeproj -scheme BankQMSStaff -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm --filter './packages/**' --filter './apps/**' --if-present test && pnpm build:site && node --test tests/*.test.mjs",
    "test:e2e": "pnpm --filter @qms/e2e test",
    "test:integration": "pnpm --filter @qms/api test:integration",
    "test:performance": "pnpm --filter @qms/performance test",
    "lint": "pnpm -r --if-present lint && bash scripts/sites-env.sh -- eslint app components lib --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.site.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @qms/api prisma generate",
    "db:migrate": "pnpm --filter @qms/api prisma migrate deploy",
    "db:seed": "pnpm --filter @qms/api db:seed"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76",
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "prettier": "^3.6.2",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Bank QMS"
}
