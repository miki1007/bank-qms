{
  "name": "@qms/staff-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:admin",
    "dev:admin": "VITE_STAFF_ROLE=ADMIN vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:manager": "VITE_STAFF_ROLE=MANAGER vite --host 0.0.0.0 --port 5177 --strictPort",
    "dev:teller": "VITE_STAFF_ROLE=TELLER vite --host 0.0.0.0 --port 5178 --strictPort",
    "build": "tsc -b && pnpm run build:admin && pnpm run build:manager && pnpm run build:teller",
    "build:admin": "VITE_STAFF_ROLE=ADMIN vite build --outDir dist/admin",
    "build:manager": "VITE_STAFF_ROLE=MANAGER vite build --outDir dist/manager",
    "build:teller": "VITE_STAFF_ROLE=TELLER vite build --outDir dist/teller",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.5",
    "@qms/shared-types": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
